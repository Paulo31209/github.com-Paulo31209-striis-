# Copie para .env e preencha. O .env NÃO vai para o Git (está no .gitignore).

# --- Engine Strix (pentest com IA) ---
# Provedor/modelo do LLM. Ex.: openai/gpt-4.1, openai/gpt-4o-mini, anthropic/claude-sonnet-4
STRIX_LLM=openai/gpt-4.1
# Chave da API do seu provedor de LLM.
LLM_API_KEY=coloque_sua_chave_aqui

# --- Opcionais ---
# Modo de scan: quick | standard | deep
STRIX_SCAN_MODE=standard
# Teto de gasto por scan em USD (recomendado!).
STRIX_MAX_BUDGET=2
# Caminho do binário do strix, caso não esteja no PATH (ex.: venv).
# STRIX_BIN=/home/saulo/.local/bin/strix
# Diretório onde ficará a pasta strix_runs/ (default: pasta do projeto).
# STRIX_WORKDIR=/home/saulo/striis
# Porta do dashboard (default: 3000).
# PORT=3000

# --- Trava de acesso ---
# Defina um PIN para exigir login no dashboard. Sem STRIIS_PIN, o acesso fica aberto.
# STRIIS_PIN=147171
